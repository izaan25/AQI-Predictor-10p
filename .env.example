# ════════════════════════════════════════════════════════════════
#  Pearls AQI Predictor — Environment Variables
#  Copy this file to .env and fill in your free API keys
# ════════════════════════════════════════════════════════════════

# ── 1. AQICN (Real-time AQI data) ────────────────────────────────
#    Get FREE token at: https://aqicn.org/data-platform/token/
#    Takes ~30 seconds, no credit card, instant token by email
AQICN_TOKEN=your_aqicn_token_here

# ── 2. OpenWeatherMap (Weather features) ──────────────────────────
#    Get FREE key at: https://home.openweathermap.org/users/sign_up
#    Free tier: 1,000,000 calls/month — more than enough
OW_API_KEY=your_openweather_api_key_here

# ── 3. Hopsworks (Feature Store) ──────────────────────────────────
#    FREE account at: https://app.hopsworks.ai
#    $4,000 free credits, no credit card required
#    After signup: Settings → API Keys → Create API Key
#    Leave blank to use LOCAL storage instead (SQLite/CSV)
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT=pearls-aqi

# ── 4. App settings ───────────────────────────────────────────────
TARGET_CITY=karachi
FLASK_PORT=5050
LOG_LEVEL=INFO

# ── 5. Storage mode ───────────────────────────────────────────────
#    "local"     → saves features to data/features.db (SQLite) — works offline, 100% free
#    "hopsworks" → saves to Hopsworks cloud feature store
STORAGE_MODE=local
